# ---- Server ----
PORT=5000
NODE_ENV=development

# ---- Database ----
MONGO_URL=mongodb://127.0.0.1:27017/mtec_leads

# ---- Auth ----
# long random string, e.g. run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d

# ---- CORS (comma separated list of frontend origins) ----
CLIENT_URL=http://localhost:5173

# ---- Stripe payments ----
STRIPE_CURRENCY=egp
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Guest course access email (Resend) ----
RESEND_API_KEY=
EMAIL_FROM="MTEC SkillUp <courses@example.com>"

# ---- Seed admin (used by: npm run seed) ----
ADMIN_NAME=MTEC Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
